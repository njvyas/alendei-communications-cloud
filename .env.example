# =============================================================================
# Alendei Communications Cloud — example environment
#
# Copy to `.env` and adjust. `.env` is git-ignored and MUST NEVER be committed.
# Every value below is validated at startup (apps/api/src/config); the process
# refuses to boot on invalid or missing mandatory configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# APP_ENV drives production-only hardening checks (see SECRETS_BACKEND below).
# one of: development | test | staging | production
APP_ENV=development
SERVICE_NAME=acc-api
LOG_LEVEL=debug
# Pretty-print logs locally. Always `false` outside development (structured JSON only).
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# HTTP API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
# Comma-separated exact origins. `*` is rejected when APP_ENV=production.
CORS_ORIGINS=http://localhost:3000
# Seconds the process waits for in-flight work during graceful shutdown.
SHUTDOWN_TIMEOUT_SECONDS=15
# Serve Swagger UI. Forced off when APP_ENV=production unless explicitly enabled.
OPENAPI_UI_ENABLED=true

# -----------------------------------------------------------------------------
# PostgreSQL — the correctness boundary (DATABASE.md §1)
#
# Three distinct principals, by design:
#   DATABASE_URL        application role (acc_app)   — RLS ENFORCED, never owner
#   DATABASE_AUTH_URL   identity role (acc_auth)     — credential verification only,
#                                                      runs before tenant context exists
#   DATABASE_ADMIN_URL  owner/superuser              — migrations, seeding
#   DATABASE_RELAY_URL  outbox relay role (acc_relay)— cross-tenant read of outbox only
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://acc_app:acc_app_dev_password@localhost:5432/acc
DATABASE_AUTH_URL=postgres://acc_auth:acc_auth_dev_password@localhost:5432/acc
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_password@localhost:5432/acc
DATABASE_RELAY_URL=postgres://acc_relay:acc_relay_dev_password@localhost:5432/acc

# Passwords used by `npm run db:migrate` to grant LOGIN to the non-owner roles.
DATABASE_APP_PASSWORD=acc_app_dev_password
DATABASE_AUTH_PASSWORD=acc_auth_dev_password
DATABASE_RELAY_PASSWORD=acc_relay_dev_password

DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis — accelerator only, never a system of record (DATABASE.md §1)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=acc

# -----------------------------------------------------------------------------
# Event bus — Kafka-wire-compatible broker (EVENTS.md §1; Redpanda locally)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=acc-api
KAFKA_SSL=false
EVENT_TOPIC_PREFIX=alendei
# Outbox relay polling (EVENTS.md §1 transactional outbox)
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_MAX_ATTEMPTS=10

# -----------------------------------------------------------------------------
# Secrets (SECURITY.md §3)
#
# Application code resolves secrets through SecretsPort, never by reading a raw
# value directly. Config below holds *references* of the form `<backend>:<locator>`.
# Only the `env` backend is implemented in Phase 1; APP_ENV=production with
# SECRETS_BACKEND=env is rejected at startup by design.
# -----------------------------------------------------------------------------
SECRETS_BACKEND=env
AUTH_JWT_SECRET_REF=env:ACC_DEV_JWT_SECRET

# Development-only secret material. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACC_DEV_JWT_SECRET=CHANGE_ME_dev_only_secret_at_least_32_chars_long_0123456789abcdef

# -----------------------------------------------------------------------------
# Authentication & sessions (RBAC.md §5, API.md §9)
# -----------------------------------------------------------------------------
AUTH_JWT_ISSUER=acc
AUTH_JWT_AUDIENCE=acc-console
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_WS_TICKET_TTL_SECONDS=30
AUTH_MAX_SESSIONS_PER_USER=25
# Argon2id parameters for password and API-key secret hashing.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Rate limiting foundation (API.md §5)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=600
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10

# -----------------------------------------------------------------------------
# Observability (OBSERVABILITY.md)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=1.0
METRICS_ENABLED=true
METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_* values are compiled into the browser
# bundle. Never place a secret behind a NEXT_PUBLIC_ prefix.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_ENV=development
