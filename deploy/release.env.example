# ACC controlled-MVP release environment (docs/RELEASE.md §3).
#
# Copy to deploy/release.env on the release host only, fill every <...>, and
#   chmod 600 deploy/release.env
# It holds credentials: never commit it, never paste it into tickets or chat.
# Generate each secret independently, e.g. `openssl rand -base64 36 | tr -d '/+='`.
# The API refuses to start on any invalid value (env.schema.ts) and names the
# variable, never its value.

# --- Image and compose ---------------------------------------------------------
ACC_VERSION=<image tag, e.g. 2026.10.30-<git short sha>>
POSTGRES_DB=acc
POSTGRES_PASSWORD=<superuser password; also inside DATABASE_ADMIN_URL below>

# --- Runtime ---------------------------------------------------------------------
# `staging` until a non-env secrets backend exists: APP_ENV=production refuses
# SECRETS_BACKEND=env by design (SECURITY.md §3), and no other backend is
# implemented yet. See docs/RELEASE.md §2.
APP_ENV=staging
NODE_ENV=production
SERVICE_NAME=acc-api
LOG_LEVEL=info
LOG_PRETTY=false
API_HOST=0.0.0.0
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
# The public console origin(s), https only.
CORS_ORIGINS=https://<console host>
# Exactly the number of reverse proxies in front of the API (one TLS proxy: 1).
TRUSTED_PROXY_HOPS=1
SHUTDOWN_TIMEOUT_SECONDS=15
OPENAPI_UI_ENABLED=false

# --- PostgreSQL (compose service `postgres`) ------------------------------------
DATABASE_URL=postgres://acc_app:<acc_app password>@postgres:5432/acc
DATABASE_AUTH_URL=postgres://acc_auth:<acc_auth password>@postgres:5432/acc
DATABASE_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@postgres:5432/acc
DATABASE_RELAY_URL=postgres://acc_relay:<acc_relay password>@postgres:5432/acc
# Set by `roles` (db:roles:reconcile) on the four application roles; must match the URLs above.
DATABASE_APP_PASSWORD=<acc_app password>
DATABASE_AUTH_PASSWORD=<acc_auth password>
DATABASE_RELAY_PASSWORD=<acc_relay password>
# The dispatch credential (B3): required outside development; the development
# password is refused. DATABASE_DISPATCH_URL may be given instead.
DATABASE_DISPATCH_PASSWORD=<acc_dispatch password>
ACC_ROLE_RECONCILE_TARGET=acc
# The bundled PostgreSQL is on the private compose network without TLS. A managed
# database must set DATABASE_SSL=true.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Redis (compose service `redis`, private network) ---------------------------
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=acc

# --- Event bus: configured, not used by the MVP (no producer or consumer runs) ---
KAFKA_BROKERS=unused:9092
OUTBOX_RELAY_ENABLED=false

# --- Message dispatch (ADR-014 D18) --------------------------------------------
DISPATCH_WORKER_ENABLED=true
DISPATCH_WORKER_POLL_INTERVAL_MS=1000
DISPATCH_WORKER_BATCH_SIZE=10

# --- Secrets (env backend; see APP_ENV above) -----------------------------------
SECRETS_BACKEND=env
AUTH_JWT_SECRET_REF=env:ACC_JWT_SECRET
ACC_JWT_SECRET=<at least 32 random bytes>
AUTH_JWT_ISSUER=https://<console host>
AUTH_JWT_AUDIENCE=acc-api

# --- First platform administrator (`bootstrap`, run once) -----------------------
AUTH_BOOTSTRAP_EMAIL=<operator email>
AUTH_BOOTSTRAP_PASSWORD_REF=env:AUTH_BOOTSTRAP_PASSWORD
AUTH_BOOTSTRAP_PASSWORD=<initial operator password; rotate after first sign-in>

# --- Observability ---------------------------------------------------------------
OTEL_ENABLED=false
METRICS_ENABLED=true
