          },
          "expr": "sum by (channel, outcome) (increase(acc_provider_health_checks_total[5m]))",
          "legendFormat": "{{channel}} {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Health transitions (5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
