{
  "step": "ADR-015 remediation step 3 — R-5 classification and allowed-scope sets (migration 0026), R-6 grant-side delegation",
  "usage": "source the DATABASE_* environment of a test template database at migration 0024 or later, then: node scripts/mutation/run.mjs scripts/mutation/catalogue/step3-r5-r6.json --out <dir>. Every DB command first applies the (mutated) migrations to its disposable clone. The seed command (dbcat) resolves @acc/contracts through node_modules, so contracts mutants are judged by the unit and API commands.",
  "commands": {
    "unit": {
      "cwd": ".",
      "db": false,
      "argv": [
        "bash",
        "-c",
        "cd apps/api && npx jest --selectProjects unit --testPathPatterns permission-classification"
      ],
      "timeoutSeconds": 300
    },
    "dbsec": {
      "cwd": ".",
      "db": true,
      "argv": [
        "bash",
        "-c",
        "npm run db:migrate --workspace @acc/db && cd apps/api && npx jest --selectProjects security --runInBand --testPathPatterns permission-classification"
      ],
      "timeoutSeconds": 900
    },
    "delegation": {
      "cwd": ".",
      "db": true,
      "argv": [
        "bash",
        "-c",
        "npm run db:migrate --workspace @acc/db && cd apps/api && npx jest --selectProjects security --runInBand --testPathPatterns role-assignment-delegation"
      ],
      "timeoutSeconds": 900
    },
    "dbcat": {
      "cwd": ".",
      "db": true,
      "argv": [
        "bash",
        "-c",
        "npm run db:migrate --workspace @acc/db && cd packages/db && npx jest --selectProjects integration --runInBand --testPathPatterns \"schema|backstop-definitions|seed-classification\""
      ],
      "timeoutSeconds": 900
    }
  },
  "mutants": [
    {
      "id": "M1",
      "title": "alendei_super_admin back to the whole catalogue (Object.values(P))",
      "edits": [
        {
          "file": "packages/contracts/src/roles.ts",
          "search": "    permissions: SUPER_ADMIN_PERMISSIONS,",
          "replace": "    permissions: Object.values(P),"
        }
      ],
      "commands": ["unit"]
    },
    {
      "id": "M2",
      "title": "evaluator predicate removed: a grant confers whatever its role carries",
      "edits": [
        {
          "file": "apps/api/src/auth/permission-evaluator.service.ts",
          "search": "    if (!grantConfers(grant, permission)) return false;",
          "replace": "    if (!grant.permissions.includes(permission)) return false;"
        }
      ],
      "commands": ["unit"]
    },
    {
      "id": "M3",
      "title": "API-key creator intersection ignores the allowed-scope sets",
      "edits": [
        {
          "file": "apps/api/src/auth/auth.guard.ts",
          "search": "grant.permissions.filter((permission) => grantConfers(grant, permission)),",
          "replace": "grant.permissions,"
        }
      ],
      "commands": ["unit"]
    },
    {
      "id": "M4",
      "title": "contacts.read scope set widened to include platform in contracts",
      "edits": [
        {
          "file": "packages/contracts/src/permissions.ts",
          "search": "    [P.CONTACTS_READ]: Object.freeze(['organization', 'workspace']),",
          "replace": "    [P.CONTACTS_READ]: Object.freeze(['platform', 'organization', 'workspace']),"
        }
      ],
      "commands": ["unit"]
    },
    {
      "id": "M4b",
      "title": "templates.read scope set widened to include reseller in contracts",
      "edits": [
        {
          "file": "packages/contracts/src/permissions.ts",
          "search": "    [P.TEMPLATES_READ]: Object.freeze(['organization']),",
          "replace": "    [P.TEMPLATES_READ]: Object.freeze(['reseller', 'organization']),"
        }
      ],
      "commands": ["unit"]
    },
    {
      "id": "M5",
